{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/external-evidence-manifest-1.0.json",
  "title": "Manifest für externe Implementierungsevidenz",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "language": {
      "const": "de"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repositoryUrl",
        "commit",
        "path",
        "lineStart",
        "lineEnd",
        "description",
        "verificationMethod"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EV-[0-9]{3,}$"
        },
        "repositoryUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "lineStart": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "lineEnd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "verificationMethod": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
